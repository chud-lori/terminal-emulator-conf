# Terminal & Shell
brew "zellij"
brew "oh-my-posh"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Modern CLI replacements (better performance)
brew "ripgrep"        # rg: faster grep (used by telescope live_grep)
brew "fd"             # fd: faster find
brew "bat"            # bat: cat with syntax highlighting
brew "eza"            # eza: modern ls with icons and git status
brew "fzf"            # fzf: fuzzy finder
brew "delta"          # delta: better git diff viewer
brew "dust"           # dust: better du (disk usage)
brew "procs"          # procs: better ps (process viewer)

# Git
brew "lazygit"        # lazygit: TUI git client
brew "git-delta"      # better git diffs (alias for delta)

# Language toolchains
brew "go"
brew "rust"
brew "node"

# Dev tools
brew "jq"             # JSON processor
brew "yq"             # YAML processor
brew "httpie"         # http: better curl
brew "hyperfine"      # benchmarking tool
brew "tokei"          # count lines of code

